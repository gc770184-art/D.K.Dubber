<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Anime AI Dubbed - Stream</title>
  <style>
    body { 
      font-family: Arial, sans-serif; 
      background-color: #121212; 
      color: #fff; 
      text-align: center; 
      margin: 0; 
      padding: 20px; 
    }
    h1 { 
      color: #e50914; 
      margin-bottom: 20px;
    }
    .player-container { 
      position: relative; 
      padding-bottom: 56.25%; 
      height: 0; 
      overflow: hidden; 
      max-width: 800px; 
      margin: 0 auto; 
      border-radius: 8px; 
      box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    }
    .player-container iframe { 
      position: absolute; 
      top: 0; 
      left: 0; 
      width: 100%; 
      height: 100%; 
      border: none; 
    }
    .btn-container { 
      margin-top: 20px; 
    }
    .ep-btn { 
      background: #e50914; 
      color: white; 
      border: none; 
      padding: 12px 20px; 
      margin: 5px; 
      cursor: pointer; 
      border-radius: 5px; 
      font-weight: bold; 
      font-size: 15px;
      transition: 0.2s;
    }
    .ep-btn:hover { 
      background: #b20710; 
      transform: scale(1.05);
    }
  </style>
</head>
<body>

  <h1>The Great Ruler (Hindi Dubbed)</h1>

  <!-- Rumble Video Player -->
  <div class="player-container">
    <iframe id="rumble-player" src="https://rumble.com/embed/v7e00s0/?pub=4qmeas" allowfullscreen></iframe>
  </div>

  <!-- Episode Selection Buttons -->
  <div class="btn-container">
    <button class="ep-btn" onclick="changeVideo('https://rumble.com/embed/v7e00s0/?pub=4qmeas')">Episode 1</button>
    <!-- Baad me naye episodes ke liye niche wale button ka link badal sakte hain -->
    <button class="ep-btn" onclick="changeVideo('https://rumble.com/embed/v7e00s0/?pub=4qmeas')">Episode 2</button>
  </div>

  <script>
    function changeVideo(url) {
      document.getElementById('rumble-player').src = url;
    }
  </script>

</body>
</html>
